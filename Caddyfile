# Reverse proxy + automatic HTTPS (Let's Encrypt) in front of the frontend container, which
# already proxies /api/ to the backend internally (see frontend/nginx.conf) — so this file only
# needs one route. Caddy issues and renews the certificate on its own the moment this domain's
# DNS points at the host and ports 80/443 are reachable; no certbot/cron needed.
#
# Set DOMAIN in .env.prod (e.g. DOMAIN=limssoftwarenepal.com) — docker-compose.prod.yml passes it
# through as an env var Caddy substitutes here.
{$DOMAIN}, www.{$DOMAIN} {
	reverse_proxy frontend:8080
}

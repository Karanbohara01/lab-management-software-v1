# Copy this file to .env.prod and fill in real values. .env.prod itself must NEVER be committed
# (already covered by .gitignore's "*.env.prod" / local-secrets patterns — double check before
# your first commit on a new machine). Full explanation of every variable: docs/ENVIRONMENT.md.

# ---- required ---------------------------------------------------------------
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# Generate with: openssl rand -base64 48
JWT_SECRET=
# Encrypts every clinic's own payment/IRD/SMS/WhatsApp credentials at rest — generate with the
# same command as JWT_SECRET above, but use a DIFFERENT value. Losing/changing this after clinics
# have saved their own credentials makes those saved values permanently unreadable.
CRYPTO_KEY=
# The real domain this app will be served from, e.g. https://labs.example.com
APP_PUBLIC_URL=

# ---- optional: IRD / CBMS e-billing (this deployment's shared fallback; a clinic can override
# from Settings → Laboratory profile) ------------------------------------------
IRD_ENABLED=false
IRD_USERNAME=
IRD_PASSWORD=
IRD_SELLER_PAN=

# ---- optional: SMS report delivery (shared fallback; per-clinic override available) ----------
SMS_ENABLED=false
SMS_PROVIDER=
SMS_BASE_URL=
SMS_API_KEY=
SMS_FROM=

# ---- optional: WhatsApp report delivery (shared fallback; per-clinic override available) ------
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ---- optional: eSewa online payment (shared fallback; per-clinic override available). Also the
# ONLY account used to collect recurring subscription billing from clinics themselves (see
# SUBSCRIPTION_BILLING_CRON below) — that's platform revenue, so this one matters even if every
# clinic ends up configuring its own eSewa/Khalti for patient billing. ------------------------
ESEWA_ENABLED=false
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=

# ---- optional: Khalti online payment (shared fallback; per-clinic override available) ---------
KHALTI_ENABLED=false
KHALTI_SECRET_KEY=

# ---- optional: overrides -----------------------------------------------------
# HTTP_PORT=80
# BACKUP_CRON=0 0 2 * * *
# SUBSCRIPTION_BILLING_CRON=0 30 2 * * *
# CORS_ALLOWED_ORIGINS=https://labs.example.com

# Copy this file to .env.prod and fill in real values. .env.prod itself must NEVER be committed
# (already covered by .gitignore's "*.env.prod" / local-secrets patterns — double check before
# your first commit on a new machine). Full explanation of every variable: docs/ENVIRONMENT.md.

# ---- required ---------------------------------------------------------------
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# Generate with: openssl rand -base64 48
JWT_SECRET=
# The real domain this app will be served from, e.g. https://labs.example.com
APP_PUBLIC_URL=

# ---- optional: IRD / CBMS e-billing ------------------------------------------
IRD_ENABLED=false
IRD_USERNAME=
IRD_PASSWORD=
IRD_SELLER_PAN=

# ---- optional: SMS report delivery -------------------------------------------
SMS_PROVIDER=
SMS_BASE_URL=
SMS_API_KEY=
SMS_FROM=

# ---- optional: WhatsApp report delivery --------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ---- optional: eSewa online payment ------------------------------------------
ESEWA_ENABLED=false
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=

# ---- optional: Khalti online payment -----------------------------------------
KHALTI_ENABLED=false
KHALTI_SECRET_KEY=

# ---- optional: overrides -----------------------------------------------------
# HTTP_PORT=80
# BACKUP_CRON=0 0 2 * * *
# CORS_ALLOWED_ORIGINS=https://labs.example.com

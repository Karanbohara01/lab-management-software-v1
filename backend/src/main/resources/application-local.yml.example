# Copy to application-local.yml (git-ignored) and fill in real local values.
lims:
  security:
    jwt:
      # Generate a strong 256-bit+ secret, e.g:  openssl rand -base64 48
      secret: "REPLACE_WITH_LONG_RANDOM_SECRET"

spring:
  datasource:
    url: jdbc:mysql://localhost:3307/lims?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
    username: lims
    password: lims
